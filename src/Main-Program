.eqv ACH_BONUS 2
.eqv ACH_FLAG_SURV 1
.eqv ACH_FLAG_MEL 2
.eqv ACH_FLAG_COMEBACK 4
.eqv ACH_FLAG_VIGIL 8
.eqv ACH_FLAG_MAR 16
