    lw  $t1, 0($t0)
    li  $v0, 1
    move $a0, $t1
    syscall
    li  $v0, 4
    la  $a0, ach_units_nl
    syscall

    j main_loop

ach_check_mel:
    bge  $t4, $s2, ach_mel_done
    bne  $s0, $s2, ach_mel_done
    la   $t8, mel_hits
    lw   $t9, 0($t8)
    addiu $t9, $t9, 1
    sw   $t9, 0($t8)
    la   $t8, ach_flags
    lw   $t7, 0($t8)
    andi $t6, $t7, ACH_FLAG_MEL
    bnez $t6, ach_mel_done
    slti $t6, $t9, 2
    bne  $t6, $zero, ach_mel_done
    addiu $s0, $s0, ACH_BONUS
    ble  $s0, $s2, ach_mel_cap
    move $s0, $s2
ach_mel_cap:
    ori  $t7, $t7, ACH_FLAG_MEL
    sw   $t7, 0($t8)
    li   $v0, 4
    la   $a0, ach_mel_msg
    syscall
ach_mel_done:
    jr   $ra


