.text
.globl main
main:
    # Application Startup & Initial Configuration
    la  $a0, init_header # configures $s1=EDR, $s2=MEL, $s0=current energy, $s3=IEL
    jal gameInit        

main_loop:
    # Print the command prompt before reading
    li  $v0, 4
    la  $a0, command_prompt
    syscall

    # Start timer (ms)
    li  $v0, 30
    syscall
    move $s4, $a0               # s4 = start_ms (low word)

    jal  commandParser          # v0 = letter, v1 = number or -1

    move $s5, $v0               
    move $s6, $v1               

	# If pet is dead, only allow Reset or Quit
    beqz $s0, dead_command_gate

    # End timer (ms)
    li  $v0, 30
    syscall
    move $t8, $a0               # t8 = end_ms (low word)

    # Compute elapsed_seconds = EDR*((end - start) / 1000)
    subu $t0, $t8, $s4          
    li   $t1, 1000
    divu $t0, $t1
    mflo $t9                    
    mul  $t3, $s1, $t9

    # If previous loop requested a pause (achievements), zero out elapsed/depletion once
    la   $t0, timer_pause
    lw   $t1, 0($t0)
    beqz $t1, pause_done
    move $t9, $zero
    move $t3, $zero
    sw   $zero, 0($t0)
pause_done:

    # Pause timer effects while viewing achievements (A) or stats (L)
    li   $t2, 'A'
    beq  $s5, $t2, timer_pause_cmd
    li   $t2, 'L'
    beq  $s5, $t2, timer_pause_cmd
    j    timer_apply
timer_pause_cmd:
    move $t9, $zero             # ignore elapsed time
    move $t3, $zero
    # Set pause flag so the next loop also ignores elapsed time while user is viewing
    la   $t0, timer_pause
    li   $t1, 1
    sw   $t1, 0($t0)
timer_apply:
    move $s7, $t9                # stash elapsed seconds for later checks

    # Count command usage
    la   $t0, commands_used
    lw   $t1, 0($t0)
    addiu $t1, $t1, 1
    sw   $t1, 0($t0)

    # Print "Time +Ns... Natural energy depletion!" if N > 0
    beqz $t9, skip_deplete_print

    li  $v0, 4
    la  $a0, deplete_prefix
    syscall

    li  $v0, 1
    move $a0, $t9
    syscall

    li  $v0, 4
    la  $a0, deplete_suffix
    syscall

skip_deplete_print:
    # Apply depletion before command
    subu $s0, $s0, $t3

    # Check for death
    bgtz $s0, depletion_alive

    # Pet died from depletion (if above fails)
    move $s0, $zero
    
    # 1. Print dead_error, energy bar, banner
    li  $v0, 4
    la  $a0, dead_error
    syscall
    
    jal energyBar
    
    li  $v0, 4
    la  $a0, dead_banner
    syscall

    # After natural death, go back to loop to wait for Reset/Quit.
    j   main_loop

depletion_alive:
    # Function called if pet is still alive

    # Survivor achievement tick (only if time progressed)
    beqz $t9, skip_survivor_tick
    la   $t8, survive_ticks
    lw   $t7, 0($t8)
    ble  $s0, 5, surv_reset
    addiu $t7, $t7, 1           
    sw   $t7, 0($t8)
    j surv_check
surv_reset:
    sw   $zero, 0($t8)
surv_check:
    la   $t6, ach_flags
    lw   $t5, 0($t6)
    andi $t4, $t5, ACH_FLAG_SURV
    bnez $t4, surv_done
    li   $t4, ACH_SURVIVE_TICKS
    blt  $t7, $t4, surv_done
    addiu $s0, $s0, ACH_BONUS
    ble  $s0, $s2, surv_cap
    move $s0, $s2
surv_cap:
    ori  $t5, $t5, ACH_FLAG_SURV
    sw   $t5, 0($t6)
    li   $v0, 4
    la   $a0, ach_survivor_msg
    syscall
surv_done:
skip_survivor_tick:

    # Session total ticks (accumulate elapsed seconds)
    beqz $t9, skip_total_ticks
    la   $t8, total_ticks
    lw   $t7, 0($t8)
    addu $t7, $t7, $t9
    sw   $t7, 0($t8)
skip_total_ticks:

    # Track longest streak above threshold (energy >10)
    la   $t8, high_streak_cur
    lw   $t7, 0($t8)
    li   $t6, HIGH_STREAK_THRESHOLD
    ble  $s0, $t6, streak_reset
    beqz $t9, streak_done
    addu $t7, $t7, $t9
    sw   $t7, 0($t8)
    la   $t6, high_streak_max
    lw   $t5, 0($t6)
    bge  $t5, $t7, streak_done
    sw   $t7, 0($t6)
    j    streak_done
streak_reset:
    sw   $zero, 0($t8)
streak_done:

    # Marathon achievement (survive 300 ticks in one life)
    beqz $t9, skip_marathon_tick
    la   $t8, marathon_ticks
    lw   $t7, 0($t8)
    la   $t6, ach_flags
    lw   $t5, 0($t6)
    andi $t4, $t5, ACH_FLAG_MAR
    bnez $t4, skip_marathon_tick
    addu $t7, $t7, $t9        # accumulate actual elapsed seconds
    sw   $t7, 0($t8)
    li   $t4, ACH_MARATHON_TICKS
    blt  $t7, $t4, skip_marathon_tick
    addiu $s0, $s0, ACH_BONUS_MAR
    ble  $s0, $s2, marathon_cap
    move $s0, $s2
marathon_cap:
    ori  $t5, $t5, ACH_FLAG_MAR
    sw   $t5, 0($t6)
    li   $v0, 4
    la   $a0, ach_marathon_msg
    syscall
skip_marathon_tick:

    # Vigilant achievement (stay above 3 for 40 ticks)
    beqz $t9, skip_vigil_tick
    la   $t8, vigil_ticks
    lw   $t7, 0($t8)
    la   $t6, ach_flags
    lw   $t5, 0($t6)
    andi $t4, $t5, ACH_FLAG_VIGIL
    bnez $t4, skip_vigil_tick
    li   $t4, 3
    ble  $s0, $t4, vigil_reset
    addu $t7, $t7, $t9        # accumulate actual elapsed seconds this loop
    sw   $t7, 0($t8)
    li   $t4, ACH_VIGIL_TICKS
    blt  $t7, $t4, skip_vigil_tick
    addiu $s0, $s0, ACH_BONUS
    ble  $s0, $s2, vigil_cap
    move $s0, $s2
vigil_cap:
    ori  $t5, $t5, ACH_FLAG_VIGIL
    sw   $t5, 0($t6)
    li   $v0, 4
    la   $a0, ach_vigil_msg
    syscall
    sw   $zero, 0($t8)
    j    skip_vigil_tick
vigil_reset:
    sw   $zero, 0($t8)
skip_vigil_tick:

    # Comeback Kid tracking (recover from 1 -> >=10 within 5 ticks)
    la   $t8, comeback_ticks
    lw   $t7, 0($t8)            # t7 = ticks since hit 1 (0 = inactive)
    la   $t6, ach_flags
    lw   $t5, 0($t6)
    andi $t4, $t5, ACH_FLAG_COMEBACK
    bnez $t4, comeback_done     # already unlocked

    # Start window if currently at energy 1 and no active window
    li   $t4, 1
    bne  $s0, $t4, comeback_active_check
    bnez $t7, comeback_active_check
    li   $t7, 1                 # start counting with this tick
    sw   $t7, 0($t8)

comeback_active_check:
    beqz $t7, comeback_done     # not active

    # Advance window only when time progressed
    beqz $t9, comeback_after_tick
    addiu $t7, $t7, 1
    sw   $t7, 0($t8)

comeback_after_tick:
    # Reset if window exceeded (time progressed) or pet died
    li   $t4, 5
    ble  $t7, $t4, comeback_die_check
comeback_reset:
    sw   $zero, 0($t8)
    j    comeback_done
comeback_die_check:
    beqz $s0, comeback_reset
    # else keep waiting within window

comeback_done:

    # 1. Show energy bar (Post-depletion state)
    jal energyBar

    move $t0, $s5
    move $t1, $s6

#Takes user input and moves to appropriate function from that
alive_command_dispatch:

    li   $t2, 'Q'
    beq  $t0, $t2, quit_program

    li   $t2, 'F'
    beq  $t0, $t2, do_feed

    li   $t2, 'E'
    beq  $t0, $t2, do_entertain

    li   $t2, 'A'
    beq  $t0, $t2, do_view_ach

    # If command is 'L', view session stats
    li   $t2, 'L'
    beq  $t0, $t2, do_view_stats

    # If command is 'P', go to Pet handler
    li   $t2, 'P'
    beq  $t0, $t2, do_pet

    li   $t2, 'I'
    beq  $t0, $t2, do_ignore

    li   $t2, 'R'
    beq  $t0, $t2, do_reset

    # For any other command, just go to loop (handled by parser mostly)
    j after_command

dead_command_gate:
    move $t0, $s5
    li   $t2, 'R'
    beq  $t0, $t2, do_reset
    li   $t2, 'Q'
    beq  $t0, $t2, quit_program
    li  $v0, 4
    la  $a0, dead_only_cmd
    syscall
    j   main_loop

# Reset: Restores current energy (s0) to IEL (s3)
do_reset:
    # "\nCommand recognized: Reset.\n"
    li  $v0, 4
    la  $a0, reset_recog
    syscall

    # Re-initialize the game (EDR, MEL, IEL)
    la  $a0, reset_header
    jal gameInit

    j   main_loop

    li  $v0, 4
    la  $a0, newline
    syscall

    j   main_loop

# Feed, F n: t1 = n, s0 = current energy, s2 = MEL
do_feed:
    # Store old energy and implement a 'boolean' value to $t6
    move $t4, $s0               
    li   $t6, 0                 
    addu $s0, $s0, $t1

    # Cap at MEL if below condition fails!
    ble  $s0, $s2, feed_no_cap
    move $s0, $s2
    li   $t6, 1                 
feed_no_cap:
    subu $t7, $s0, $t4          
    # "\nCommand recognized: Feed n."
    li  $v0, 4
    la  $a0, feed_recog
    syscall

    li  $v0, 1
    move $a0, $t1
    syscall

    li  $v0, 4
    la  $a0, feed_dot_nl
    syscall

    li  $v0, 4
    la  $a0, feed_inc
    syscall

    li  $v0, 1
    move $a0, $t7
    syscall

    li  $v0, 4
    la  $a0, feed_units_nl
    syscall

    beqz $t6, feed_show_bar
    li  $v0, 4
    la  $a0, cap_error
    syscall

feed_show_bar:
    jal ach_check_mel
	jal energyBar

    # After feeding, go to natural depletion step
    j after_command

# Entertain, E n: t1 = n, s0 = current energy, s2 = MEL
do_entertain:
    move $t4, $s0               
    sll  $t5, $t1, 1            
    li   $t6, 0                 
    addu $s0, $s0, $t5          

    ble  $s0, $s2, ent_no_cap
    move $s0, $s2
    li   $t6, 1                 
ent_no_cap:
    subu $t7, $s0, $t4          

    li  $v0, 4
    la  $a0, entertain_recog
    syscall

    li  $v0, 1
    move $a0, $t1
    syscall

    li  $v0, 4
    la  $a0, entertain_dot_nl
    syscall

    li  $v0, 4
    la  $a0, feed_inc
    syscall

    li  $v0, 1
    move $a0, $t7
    syscall

    li  $v0, 4
    la  $a0, feed_units_nl
    syscall

    beqz $t6, ent_show_bar
    li  $v0, 4
    la  $a0, cap_error
    syscall

ent_show_bar:
    jal ach_check_mel
    jal energyBar
    j after_command

# Pet, P n: t1 = n, s0 = current energy, s2 = MEL
do_pet:
    move $t4, $s0               
    sll  $t5, $t1, 1            
    li   $t6, 0                 
    addu $s0, $s0, $t5

    ble  $s0, $s2, pet_no_cap
    move $s0, $s2
    li   $t6, 1
pet_no_cap:
    subu $t7, $s0, $t4          

    li  $v0, 4
    la  $a0, pet_recog
    syscall

    li  $v0, 1
    move $a0, $t1
    syscall

    li  $v0, 4
    la  $a0, pet_dot_nl
    syscall

    li  $v0, 4
    la  $a0, feed_inc
    syscall

    li  $v0, 1
    move $a0, $t7
    syscall

    li  $v0, 4
    la  $a0, feed_units_nl
    syscall

    beqz $t6, pet_show_bar
    li  $v0, 4
    la  $a0, cap_error
    syscall

pet_show_bar:
    jal ach_check_mel
    jal energyBar
    j after_command

# Ignore, I n: t1 = n, s0 = current energy
do_ignore:
    move $t4, $s0               # remember old energy
    li   $t6, 0                 # 'boolean' for if pet died
    sll  $t5, $t1, 1            
    addu $t5, $t5, $t1          # 2n + n = 3n
    subu $s0, $s0, $t5          

    bgtz $s0, ign_no_death
    move $s0, $zero
    li   $t6, 1                 
ign_no_death:
    subu $t7, $t4, $s0          

    li  $v0, 4
    la  $a0, ignore_recog
    syscall

    li  $v0, 1
    move $a0, $t1
    syscall

    li  $v0, 4
    la  $a0, ignore_dot_nl
    syscall

    li  $v0, 4
    la  $a0, ignore_dec
    syscall

    li  $v0, 1
    move $a0, $t7               
    syscall

    li  $v0, 4
    la  $a0, ignore_units
    syscall

    li  $v0, 4
    la  $a0, ignore_mult_open
    syscall

    li  $v0, 1
    move $a0, $t1               
    syscall

    li  $v0, 4
    la  $a0, ignore_mult_close_nl
    syscall

    beqz $t6, ign_show_bar
    li  $v0, 4
    la  $a0, dead_error
    syscall

ign_show_bar:
    jal energyBar
    bnez $t6, pet_dead_flow
    j after_command

after_command:
    # If no time elapsed this loop (e.g., viewing Achievements), skip auto-heal
    beqz $s7, heal_no_time

    # Comeback Kid success check after command effects
    la   $t0, comeback_ticks
    lw   $t1, 0($t0)
    beqz $t1, comeback_post_done
    li   $t2, 5
    bgt  $t1, $t2, comeback_post_reset
    beqz $s0, comeback_post_reset
    li   $t2, 10
    blt  $s0, $t2, comeback_post_done
    addiu $s0, $s0, ACH_BONUS
    ble  $s0, $s2, comeback_post_cap
    move $s0, $s2
comeback_post_cap:
    la   $t3, ach_flags
    lw   $t4, 0($t3)
    ori  $t4, $t4, ACH_FLAG_COMEBACK
    sw   $t4, 0($t3)
    li   $v0, 4
    la   $a0, ach_comeback_msg
    syscall
    sw   $zero, 0($t0)
    j    comeback_post_done
comeback_post_reset:
    sw   $zero, 0($t0)
comeback_post_done:

    # --- Auto-Healing Logic ---
    # Auto-heal if energy stays above threshold for consecutive ticks
    move $t6, $zero             
    
    # t4 = streak count
    la   $t5, heal_counter
    lw   $t4, 0($t5)            

    beqz $s0, heal_reset
    li  $t8, HEAL_THRESHOLD
    blt $s0, $t8, heal_reset
    
    addiu $t4, $t4, 1
    
    li  $t9, HEAL_TICKS
    blt $t4, $t9, heal_save_only

    addiu $s0, $s0, 1
    ble  $s0, $s2, heal_cap_done
    move $s0, $s2
heal_cap_done:
    move $t4, $zero             # Reset streak after heal
    li   $t6, 1                 # Set heal flag
    # Count heal trigger
    la   $t5, heals_triggered
    lw   $t4, 0($t5)
    addiu $t4, $t4, 1
    sw   $t4, 0($t5)
    j heal_save_only

heal_reset:
    move $t4, $zero             

heal_save_only:
    sw   $t4, 0($t5)            
    j heal_done

heal_no_time:
    j heal_done

heal_done:
    beqz $t6, skip_heal_msg
    li  $v0, 4
    la  $a0, auto_heal_msg
    syscall
skip_heal_msg: 
    li  $v0, 4
    la  $a0, newline
    syscall

    # Low energy warning
    beqz $s0, skip_warning
    ble  $s0, LOW_ENERGY_THRESHOLD, show_warning
    j skip_warning
show_warning:
    li  $v0, 4
    la  $a0, warning_low
    syscall
skip_warning:

    # If pet died from natural depletion, show death banner and prompt
    beqz $s0, pet_dead_flow

    j   main_loop

do_view_ach:
    li  $v0, 4
