.eqv BUFFER_SIZE 32 #>1
.eqv MAX_NUMERIC_VALUE 2 #>0
.eqv BAR_WIDTH 20
.eqv HEAL_THRESHOLD 10
.eqv HEAL_TICKS 2
.eqv LOW_ENERGY_THRESHOLD 3
.macro READ_INPUT (%addr, %len)
    li  $v0, 8
    la  $a0, %addr
    li  $a1, %len
    syscall
.end_macro

.data
edr: .word 1
mel: .word 15
iel: .word 5

input_buffer: .space BUFFER_SIZE

init_header: .asciiz "=== Digital Pet Simulator (MIPS32) ===\nInitializing system...\n\nPlease set parameters (press Enter for default):\nEnter Natural Energy Depletion Rate (EDR) [Default: 1]: "
init_mel: .asciiz "Enter Maximum Energy Level (MEL) [Default: 15]: "
init_iel: .asciiz "Enter Initial Energy Level (IEL) [Default: 5]: "
init_success: .asciiz "\nParameters set successfully!\n- EDR: "
init_success2: .asciiz " units/sec\n- MEL: "
init_success3: .asciiz " units\n- IEL: "
init_success4: .asciiz " units\n\nYour Digital Pet is alive! Current status:\n"
wrong_type_input_num: .asciiz "Invalid input: Only digits are allowed in this field; Maximum value is a 2-digit number: "
over_limit_num: .asciiz "The value cannot exceed "
under_limit_num: .asciiz "The value cannot be less than 1"
try_again: .asciiz ". Please try again: "
wrong_type_Input_cmd: .asciiz "Invalid input. Follow this format for 'F/E/P/I n' (n<100) or 'R/Q'. Please try again:\n" 
status_bar:      .asciiz "[######-----] Energy: "
slash:           .asciiz "/"
newline:         .asciiz "\n"
command_prompt:  .asciiz "Enter a command (F, E, P, I, R, Q) > "
deplete_prefix: .asciiz "\nTime +"
deplete_suffix: .asciiz "s...  Natural energy depletion!\n"
feed_recog:    .asciiz "\nCommand recognized: Feed "
feed_dot_nl:   .asciiz ".\n"
feed_inc:      .asciiz "Energy increased by "
feed_units_nl: .asciiz " units.\n"
entertain_recog: .asciiz "\nCommand recognized: Entertain "
entertain_dot_nl: .asciiz ".\n"
pet_recog: .asciiz "\nCommand recognized: Pet "
pet_dot_nl: .asciiz ".\n"
ignore_recog: .asciiz "\nCommand recognized: Ignore "
ignore_dot_nl: .asciiz ".\n"
ignore_dec: .asciiz "Energy decreased by "
ignore_units: .asciiz " units"
ignore_mult_open: .asciiz " (3x"
ignore_mult_close_nl: .asciiz ").\n"
cap_error: .asciiz "Error, maximum energy level reached! Capped to the Max.\n"
dead_error: .asciiz "Error, energy level equal or less than 0. DP is dead!\n"
dead_banner: .asciiz "*** Your Digital Pet has died! ***\n"
quit_recog: .asciiz "\nCommand recognized: Quit.\n"
quit_save:  .asciiz "Saving session... goodbye!\n"
quit_end:   .asciiz "--- simulation terminated ---\n"
reset_recog: .asciiz "\nCommand recognized: Reset.\n"
reset_msg:   .asciiz "Digital Pet has been reset to its initial state!\n"
energy_word: .asciiz "] Energy: "
dead_only_cmd: .asciiz "Pet is dead. Only Reset (R) or Quit (Q) are allowed.\n"
warning_low: .asciiz "*** Warning: Energy low - feed soon! ***\n"
auto_heal_msg: .asciiz "Auto-heal triggered: +1 energy.\n"

.text
.globl main
main:
    # (Application Startup & Initial Configuration)
    jal gameInit        # sets $s1=EDR, $s2=MEL, $s0=current energy, $s3=IEL

    # gameInit already printed initial status bar + command prompt.

main_loop:
    # Print the command prompt before reading
    li  $v0, 4
    la  $a0, command_prompt
    syscall

    # Start timer (ms)
    li  $v0, 30
    syscall
    move $s4, $a0               # s4 = start_ms (low word)

    jal  commandParser          # v0 = letter, v1 = number or -1

    move $s5, $v0               # s5 = command letter
    move $s6, $v1               # s6 = number

	# If pet is dead, only allow Reset or Quit
    beqz $s0, dead_command_gate

    # End timer (ms)
    li  $v0, 30
    syscall
    move $t8, $a0               # t8 = end_ms (low word)

    # Compute elapsed_seconds = (end - start) / 1000
    subu $t0, $t8, $s4          # elapsed_ms
    li   $t1, 1000
    divu $t0, $t1
    mflo $t9                    # t9 = elapsed_seconds (N)

    # Calculate depletion = EDR * elapsed_seconds
    mul  $t3, $s1, $t9

    # Print "Time +Ns... Natural energy depletion!" if N > 0
    beqz $t9, skip_deplete_print

    li  $v0, 4
    la  $a0, deplete_prefix
    syscall

    li  $v0, 1
    move $a0, $t9
    syscall

    li  $v0, 4
    la  $a0, deplete_suffix
    syscall

skip_deplete_print:
    # Apply depletion before command
    subu $s0, $s0, $t3

    # Check for death
    bgtz $s0, depletion_alive

    # CASE: Pet died from depletion
    move $s0, $zero
    
    # 1. Print dead_error
    li  $v0, 4
    la  $a0, dead_error
    syscall
    
    # 2. Print Bar (0/MAX)
    jal energyBar
    
    # 3. Print Banner
    li  $v0, 4
    la  $a0, dead_banner
    syscall

    # After natural death, just go back to loop to wait for Reset/Quit.
    j   main_loop

depletion_alive:
    # CASE: Pet is valid and alive
    
    # 1. Show energy bar (Post-depletion state)
    jal energyBar

    # 2. Proceed to command dispatch (Restore command first)
    move $t0, $s5
    move $t1, $s6

alive_command_dispatch:

    # If command is 'Q', quit the program
    li   $t2, 'Q'
    beq  $t0, $t2, quit_program

    # If command is 'F', go to Feed handler
    li   $t2, 'F'
    beq  $t0, $t2, do_feed

    # If command is 'E', go to Entertain handler
    li   $t2, 'E'
    beq  $t0, $t2, do_entertain

    # If command is 'P', go to Pet handler
    li   $t2, 'P'
    beq  $t0, $t2, do_pet

    # If command is 'I', go to Ignore handler
    li   $t2, 'I'
    beq  $t0, $t2, do_ignore

    # If command is 'R', go to Reset handler
    li   $t2, 'R'
    beq  $t0, $t2, do_reset

    # For any other command, just go to loop (handled by parser mostly)
    j after_command

dead_command_gate:
    move $t0, $s5
    li   $t2, 'R'
    beq  $t0, $t2, do_reset
    li   $t2, 'Q'
    beq  $t0, $t2, quit_program
    li  $v0, 4
    la  $a0, dead_only_cmd
    syscall
    j   main_loop

# Reset: R
# Restores current energy (s0) to the initial energy level (s3)
do_reset:
    # Set current energy back to initial IEL
    move $s0, $s3

    # "\nCommand recognized: Reset.\n"
    li  $v0, 4
    la  $a0, reset_recog
    syscall

    # "Digital Pet has been reset to its initial state!\n"
    li  $v0, 4
    la  $a0, reset_msg
    syscall

    # Show status bar with new energy (no natural depletion here)
    jal energyBar

    li  $v0, 4
    la  $a0, newline
    syscall

    # Print the command prompt again
    # (commandParser now prints the prompt)

    # Go back to main loop (no "Time +1s..." this turn)
    j   main_loop

# Feed: F n
# t1 = n, s0 = current energy, s2 = MEL
do_feed:
    move $t4, $s0               # remember old energy
    li   $t6, 0                 # cap flag
    # Increase energy: s0 = s0 + n
    addu $s0, $s0, $t1

    # Cap at MEL (max energy)
    ble  $s0, $s2, feed_no_cap
    move $s0, $s2
    li   $t6, 1                 # capped
feed_no_cap:
    subu $t7, $s0, $t4          # actual increase applied

    # "\nCommand recognized: Feed n."
    li  $v0, 4
    la  $a0, feed_recog
    syscall

    li  $v0, 1
    move $a0, $t1
    syscall

    li  $v0, 4
    la  $a0, feed_dot_nl
    syscall

    # "Energy increased by n units.\n"
    li  $v0, 4
    la  $a0, feed_inc
    syscall

    li  $v0, 1
    move $a0, $t7
    syscall

    li  $v0, 4
    la  $a0, feed_units_nl
    syscall

    beqz $t6, feed_show_bar
    li  $v0, 4
    la  $a0, cap_error
    syscall

feed_show_bar:
	jal energyBar

    # After feeding, go to natural depletion step
    j after_command

# Entertain: E n
# t1 = n, s0 = current energy, s2 = MEL
do_entertain:
    move $t4, $s0               # remember old energy
    sll  $t5, $t1, 1            # delta = 2 * n
    li   $t6, 0                 # cap flag
    addu $s0, $s0, $t5          # apply increase

    ble  $s0, $s2, ent_no_cap
    move $s0, $s2
    li   $t6, 1                 # capped
ent_no_cap:
    subu $t7, $s0, $t4          # actual increase

    li  $v0, 4
    la  $a0, entertain_recog
    syscall

    li  $v0, 1
    move $a0, $t1
    syscall

    li  $v0, 4
    la  $a0, entertain_dot_nl
    syscall

    li  $v0, 4
    la  $a0, feed_inc
    syscall

    li  $v0, 1
    move $a0, $t7
    syscall

    li  $v0, 4
    la  $a0, feed_units_nl
    syscall

    beqz $t6, ent_show_bar
    li  $v0, 4
    la  $a0, cap_error
    syscall

ent_show_bar:
    jal energyBar
    j after_command

# Pet: P n
# t1 = n, s0 = current energy, s2 = MEL
do_pet:
    move $t4, $s0               # remember old energy
    sll  $t5, $t1, 1            # delta = 2 * n
    li   $t6, 0                 # cap flag
    addu $s0, $s0, $t5

    ble  $s0, $s2, pet_no_cap
    move $s0, $s2
    li   $t6, 1
pet_no_cap:
    subu $t7, $s0, $t4          # actual increase

    li  $v0, 4
    la  $a0, pet_recog
    syscall

    li  $v0, 1
    move $a0, $t1
    syscall

    li  $v0, 4
    la  $a0, pet_dot_nl
    syscall

    li  $v0, 4
    la  $a0, feed_inc
    syscall

    li  $v0, 1
    move $a0, $t7
    syscall

    li  $v0, 4
    la  $a0, feed_units_nl
    syscall

    beqz $t6, pet_show_bar
    li  $v0, 4
    la  $a0, cap_error
    syscall

pet_show_bar:
    jal energyBar
    j after_command

# Ignore: I n
# t1 = n, s0 = current energy
do_ignore:
    move $t4, $s0               # remember old energy
    li   $t6, 0                 # death flag
    sll  $t5, $t1, 1            # delta = 2 * n
    addu $t5, $t5, $t1          # delta = 3 * n
    subu $s0, $s0, $t5          # apply decrease

    bgtz $s0, ign_no_death
    move $s0, $zero
    li   $t6, 1                 # dead
ign_no_death:
    subu $t7, $t4, $s0          # actual decrease

    li  $v0, 4
    la  $a0, ignore_recog
    syscall

    li  $v0, 1
    move $a0, $t1
    syscall

    li  $v0, 4
    la  $a0, ignore_dot_nl
    syscall

    li  $v0, 4
    la  $a0, ignore_dec
    syscall

    li  $v0, 1
    move $a0, $t7               # actual decrease
    syscall

    li  $v0, 4
    la  $a0, ignore_units
    syscall

    li  $v0, 4
    la  $a0, ignore_mult_open
    syscall

    li  $v0, 1
    move $a0, $t1               # n
    syscall

    li  $v0, 4
    la  $a0, ignore_mult_close_nl
    syscall

    beqz $t6, ign_show_bar
    li  $v0, 4
    la  $a0, dead_error
    syscall

ign_show_bar:
    jal energyBar
    bnez $t6, pet_dead_flow
    j after_command

after_command:
    # If pet already dead, skip natural depletion and go straight to death flow
    beqz $s0, pet_dead_flow

    # Simulate passage of time (1 simulated second)
    #    Natural energy depletion: subtract EDR (s1) from current energy (s0)
    sub  $s0, $s0, $s1          # s0 = s0 - s1
    bgez $s0, energy_ok         # if s0 >= 0, it's fine
    move $s0, $zero             # if it went negative, clamp to 0
energy_ok:

    # Auto-heal if energy stays above threshold for consecutive ticks
    move $t6, $zero             # heal flag
    beqz $s0, heal_reset
    li  $t8, HEAL_THRESHOLD
    blt $s0, $t8, heal_reset
    addiu $s4, $s4, 1
    li  $t9, HEAL_TICKS
    blt $s4, $t9, heal_done
    addiu $s0, $s0, 1
    ble  $s0, $s2, heal_cap_done
    move $s0, $s2
heal_cap_done:
    move $s4, $zero
    li   $t6, 1                 # healed this tick
    j heal_done
heal_reset:
    move $s4, $zero
heal_done:

    beqz $t6, skip_heal_msg
    li  $v0, 4
    la  $a0, auto_heal_msg
    syscall
skip_heal_msg:

    # Print "Time +1s...  Natural energy depletion!"
    li  $v0, 4
    la  $a0, deplete_msg
    syscall

    # Print status bar line: [######-----] Energy: current/max
    jal energyBar

    li  $v0, 4
    la  $a0, newline
    syscall

    # Low energy warning (only if alive and at/below threshold)
    beqz $s0, skip_warning
    ble  $s0, LOW_ENERGY_THRESHOLD, show_warning
    j skip_warning
show_warning:
    li  $v0, 4
    la  $a0, warning_low
    syscall
skip_warning:

    # If pet died from natural depletion, show death banner and prompt
    beqz $s0, pet_dead_flow

    # Loop back to wait for the next command
    j   main_loop


quit_program:

    li  $v0, 4
    la  $a0, quit_recog
    syscall

    # Saving session... goodbye!
    li  $v0, 4
    la  $a0, quit_save
    syscall

    # --- simulation terminated ---
    li  $v0, 4
    la  $a0, quit_end
    syscall

    li  $v0, 10
    syscall

# Shared death flow: show banner and prompt for reset/quit
pet_dead_flow:
    li  $v0, 4
    la  $a0, dead_banner
    syscall
    j main_loop

# purpose: Print startup prompts, read and store EDR/MEL/IEL via numberToMemory, echo chosen values, initialise to s registers.
gameInit:
	addiu $sp, $sp, -8
	sw $ra, 4($sp)
	
	li $v0, 4
	la $a0, init_header
	syscall
	la $a0, edr
	li $a1, -1
	jal numberToMemory
	move $s1, $v0
	li $v0, 4
	la $a0, init_mel
	syscall
	la $a0, mel
	li $a1, -1
	jal numberToMemory
	move $s2, $v0
	li $v0, 4
	la $a0, init_iel
	syscall
	la $a0, iel
	move $a1, $s2
	jal numberToMemory
	move $s3, $v0
	move $s0, $v0
	li $v0, 4
	la $a0, init_success
	syscall
	li $v0, 1
	move $a0, $s1
	syscall
	li $v0, 4
	la $a0, init_success2
	syscall
	li $v0, 1
	move $a0, $s2
	syscall
	li $v0, 4
	la $a0, init_success3
	syscall
	li $v0, 1
	move $a0, $s3
	syscall
	li $v0, 4
	la $a0, init_success4
	syscall
	jal energyBar

    li  $v0, 4
    la  $a0, newline
    syscall

    move $s4, $zero          # heal streak counter

    li $v0, 0
	
	lw $ra, 4($sp)
	addiu $sp, $sp, 8
	jr $ra
#input of a0 = variable memory address, a1 max allowed value
#output v0 as the final variable value, v1 as a flag if the variable was updated
#reruns on the unsuccessful input
numberToMemory:
	addiu $sp, $sp, -16
	sw $ra, 12($sp)
	sw $s0, 8($sp)
	sw $s1, 4($sp)
	
	move $s0, $a0
	move $s1, $a1
	NTM_read:
		READ_INPUT (input_buffer, BUFFER_SIZE)
		la $a0, input_buffer
		li $a1, MAX_NUMERIC_VALUE
		jal parseNumber
		beq $v1, 2, NTM_error
		beqz $v1, NTM_bounds
		j NTM_skip
	NTM_error:
		li $v0, 4
		la $a0, wrong_type_input_num
		syscall
		j NTM_read
	NTM_bounds:
		blez $v0, NTM_hitLowerLimit
		bltz $s1, NTM_number
		bgt $v0, $s1, NTM_hitUpperLimit
		j NTM_number
	NTM_hitLowerLimit:
		li $v0, 4
		la $a0, under_limit_num
		syscall
   		li $v0, 4
		la $a0, try_again
		syscall
		j NTM_read
	NTM_hitUpperLimit:
		li $v0, 4
		la $a0, over_limit_num
		syscall
		li    $v0, 1
    		move  $a0, $s1
   		syscall
   		li $v0, 4
		la $a0, try_again
		syscall
		j NTM_read
	NTM_number:
		sw $v0, 0($s0)
		li $v1, 0
		j NTM_return
	NTM_skip:
		lw $v0, 0($s0)
		li $v1, 1
		j NTM_return
	NTM_return:
		lw $s1, 4($sp)
		lw $s0, 8($sp)
		lw $ra, 12($sp)
		addiu $sp, $sp, 16
		jr $ra

commandParser:
	addiu $sp, $sp, -8
    	sw    $ra, 4($sp)
    	sw    $s0, 0($sp)
    	
    	CP_read:
    		READ_INPUT (input_buffer, BUFFER_SIZE)
    		la $a0, input_buffer
    		jal parseLetter
    		beqz $v1, CP_letterOk      # v1 == 0 => letter ok
    		beq  $v1, 1, CP_read       # empty input: re-read without error
    	CP_error:
    		li $v0, 4
    		la $a0, wrong_type_Input_cmd
    		syscall
    		li $v0, 4
    		la $a0, command_prompt
    		syscall
    		j CP_read
    	CP_letterOk:
    		move $s0, $v0
    		li $a1, MAX_NUMERIC_VALUE
    		jal parseNumber
    		li $t3, 2
    		beq $v1, $t3, CP_error
    		move $t1, $v0
    		move $t2, $v1
    		li $t0, 'R'
    		beq $s0, $t0, CP_noNum
    		li $t0, 'Q'
    		beq $s0, $t0, CP_noNum
    		bnez $t2, CP_error
    		move $v0, $s0
    		move $v1, $t1
    		j CP_return
    	CP_noNum:
    		li $t3, 1
    		bne $t2, $t3, CP_error
    		move $v0, $s0
    		li $v1, -1
    	CP_return:
    		lw    $s0, 0($sp)
    		lw    $ra, 4($sp)
		addiu $sp, $sp, 8
		jr $ra

parseNumber:
	li $v0, 0
	li $v1, 1
	li $t7, 0
	move $t4, $a1
	PN_skipLeadSpace:
		lb $t0, 0($a0)
		beqz $t0, PN_emptyCase 
		beq $t0, 10, PN_emptyCase 
		beq $t0, 32, PN_leadSpaceEmpty 
		beq $t0, 9, PN_leadSpaceEmpty
		j PN_charCheck1
	PN_leadSpaceEmpty:
		addi $a0, $a0, 1
		j PN_skipLeadSpace
	PN_charCheck1:
		li $t1, '0'
		li $t3, '9'
		blt $t0, $t1, PN_errorCase
		bgt $t0, $t3, PN_errorCase
		li $t7, 1
		li $t6, 1
		addi $t0, $t0, -48 
		addu $v0, $v0, $t0
	PN_charCheckLoop:
    		addi $a0, $a0, 1
    		lb   $t0, 0($a0)
    		blt  $t0, $t1, PN_trailCheck
    		bgt  $t0, $t3, PN_trailCheck
    		bge $t6, $t4, PN_errorCase
		addi $t0, $t0, -48
    		mul  $v0, $v0, 10
    		addu $v0, $v0, $t0
    		addi $t6, $t6, 1
    		j PN_charCheckLoop
    	PN_trailCheck:
    		beq $t0, $zero, PN_okCase
    		beq $t0, 10, PN_okCase
    		beq $t0, 32, PN_leadTrailEmpty
    		beq $t0, 9, PN_leadTrailEmpty
    		j PN_errorCase
    	PN_leadTrailEmpty:
    		addi $a0, $a0, 1
    		lb $t0, 0($a0)
    		j PN_trailCheck    		
    	PN_okCase:
    		beqz $t7, PN_emptyCase
    		li $v1, 0
    		jr $ra
    	PN_emptyCase:
    		jr $ra
    	PN_errorCase:
    		li $v1, 2
    		jr $ra
    		
parseLetter:
	li $v1, 1
	lb $t0, 0($a0)
	beqz $t0, PL_return
	beq $t0, 10, PL_return
	li $t1, 'a'
	li $t2, 'z'
	blt $t0, $t1, PL_check
	bgt $t0, $t2, PL_check
	addi $t0, $t0, -32
	PL_check:
		li $t3, 'F'
		beq $t0, $t3, PL_correct
		li $t3, 'E'
		beq $t0, $t3, PL_correct
		li $t3, 'P'
		beq $t0, $t3, PL_correct
		li $t3, 'I'
		beq $t0, $t3, PL_correct
		li $t3, 'R'
		beq $t0, $t3, PL_correct
		li $t3, 'Q'
		beq $t0, $t3, PL_correct
		j PL_error
	PL_correct:
		move $v0, $t0
		li $v1, 0
		addi $a0, $a0, 1
		j PL_return
	PL_error:
		li $v1, 2
	PL_return:
		jr $ra
		
energyBar:
	move $t4, $s0
	move $t2, $s2
	bltz $t4, EB_set_zero
  	bgt $t4, $t2, EB_set_mel
    	j EB_calc_bar
	EB_set_zero:
    		move $t4, $zero
    		j EB_calc_bar
	EB_set_mel:
    		move $t4, $t2
    	EB_calc_bar:
