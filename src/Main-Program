do_view_stats:
    li  $v0, 4
    la  $a0, stats_header
    syscall

    # Total ticks
    li  $v0, 4
    la  $a0, stats_ticks
    syscall
    la  $t0, total_ticks
    lw  $t1, 0($t0)
    li  $v0, 1
    move $a0, $t1
    syscall
    li  $v0, 4
    la  $a0, ach_units_nl
    syscall

    # Commands used
    li  $v0, 4
    la  $a0, stats_cmds
    syscall
    la  $t0, commands_used
    lw  $t1, 0($t0)
    li  $v0, 1
    move $a0, $t1
    syscall
    li  $v0, 4
    la  $a0, ach_units_nl
    syscall

